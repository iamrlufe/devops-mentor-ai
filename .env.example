# Copy this file to .env and fill in the secrets.
# An empty value is read as an empty string, not as "use the default",
# so keep the non-secret values below unless you mean to change them.

# Which implementation each replaceable layer uses.
# LLM_PROVIDER       implemented: gemini, groq
#                    registered:  openai, claude, ollama, openrouter, azure_openai
# EMBEDDING_PROVIDER implemented: gemini
#                    registered:  openai, voyageai, ollama, azure_openai, jina
# MEMORY_PROVIDER    implemented: postgres, in_memory (demo)
#                    registered:  redis, sqlite, mongo
# USER_STORE         implemented: postgres, in_memory (demo)
# WORKSPACE_STORE    implemented: postgres, in_memory (demo)
# CONVERSATION_STORE implemented: postgres, in_memory (demo)
# RETRIEVER_PROVIDER implemented: qdrant, empty
#                    registered:  chroma, milvus, pgvector, weaviate, pinecone
# DEFAULT_AGENT      agent used when POST /chat carries no "agent" field
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
MEMORY_PROVIDER=postgres
RETRIEVER_PROVIDER=qdrant
DEFAULT_AGENT=teacher
# Messages kept per chat by the in-process memory. 0 disables the cap.
MEMORY_MAX_MESSAGES=100
# Where the runtime workspaces are kept. Registered: in_memory
WORKSPACE_STORE=postgres
# Where the user profiles are kept. Registered: in_memory
USER_STORE=postgres
CONVERSATION_STORE=postgres
# Conversation used when a request names no chat.
DEFAULT_CHAT_ID=default
# Defaults a new profile starts with.
DEFAULT_LANGUAGE=ru
DEFAULT_TIMEZONE=UTC

# Administration. Without a key and without listed Telegram ids the
# admin endpoints refuse everyone.
ADMIN_API_KEY=
ADMIN_TELEGRAM_IDS=
ADMIN_ROLE=admin
ADMIN_SOURCE=postgres

# Organization every record belongs to until the platform is multi-tenant.
ORGANIZATION_STORE=postgres
DEFAULT_ORGANIZATION_ID=org_default
DEFAULT_ORGANIZATION_NAME=Default

# Gemini. Required for LLM_PROVIDER=gemini.
# The embedding model is used for indexing and search regardless of the
# selected chat provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq. Implemented, uses the official OpenAI-compatible endpoint.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# The settings below belong to integrations that are registered but not
# implemented yet. Leave them empty until the integration is finished; the
# model names are placeholders and should be confirmed at that point.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5


# Ollama. Runs locally and needs no API key.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Azure OpenAI. Addressed by endpoint and deployment instead of a model id.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Embedding providers that are registered but not implemented yet.
VOYAGEAI_API_KEY=
JINA_API_KEY=

# Vector store.
# This value is for running the scripts on the host. Inside docker-compose the
# api container gets QDRANT_URL=http://qdrant:6333 from the compose file.
QDRANT_URL=http://localhost:6333
# Collection shared by agents that do not declare their own.
QDRANT_COLLECTION=mentor_documents

# Telegram bot.
# API_URL points at the api service by its compose name; use
# http://localhost:8000/chat when the bot runs on the host.
TELEGRAM_TOKEN=
API_URL=http://api:8000/chat

# PostgreSQL. The platform stores profiles, workspaces, conversations and
# memory here. POSTGRES_HOST is the host value; docker-compose overrides it
# with the service name for the containers.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mentor
POSTGRES_USER=mentor
POSTGRES_PASSWORD=
# DATABASE_URL, when set, wins over the parts above.
DATABASE_URL=
# Connection pool size per process.
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
