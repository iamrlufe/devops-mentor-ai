# Copy this file to .env and fill in the secrets.
# An empty value is read as an empty string, not as "use the default",
# so keep the non-secret values below unless you mean to change them.

# Which provider the assistant talks to.
# Implemented: gemini
# Registered, not implemented yet: openai, claude, groq, ollama, openrouter,
# azure_openai
LLM_PROVIDER=gemini

# Gemini. Required for LLM_PROVIDER=gemini.
# The embedding model is used for indexing and search regardless of the
# selected chat provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# The settings below belong to providers that are not implemented yet.
# Leave them empty until the corresponding provider is finished; the model
# names are placeholders and should be confirmed at that point.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama. Runs locally and needs no API key.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Azure OpenAI. Addressed by endpoint and deployment instead of a model id.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Vector store.
# This value is for running the scripts on the host. Inside docker-compose the
# api container gets QDRANT_URL=http://qdrant:6333 from the compose file.
QDRANT_URL=http://localhost:6333

# Telegram bot.
# API_URL points at the api service by its compose name; use
# http://localhost:8000/chat when the bot runs on the host.
TELEGRAM_TOKEN=
API_URL=http://api:8000/chat

# PostgreSQL. Only docker-compose reads these, the application does not
# connect to the database yet.
POSTGRES_DB=devops_mentor
POSTGRES_USER=mentor
POSTGRES_PASSWORD=
